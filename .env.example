# --- LLM CONFIGURATION ---
# The model name for the generator (e.g., llama3.1:8b)
GEN_LLM=llama3.1:8b
# The model name for the RAGAS evaluator (e.g., gemma2:9b)
EVAL_LLM=gemma2:9b
# --- ENDPOINTS ---
# If using local Ollama (Docker uses host.docker.internal, local uses localhost)
OLLAMA_CLOUD_URL=https://ollama.com
# The API URL for the frontend to reach the backend
API_URL=http://localhost:8000
# --- EMBEDDING CONFIGURATION ---
# The HuggingFace model path for embeddings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# --- API KEYS (Leave empty if not using cloud providers) ---
OLLAMA_API_KEY=your_ollama_cloud_key_here
